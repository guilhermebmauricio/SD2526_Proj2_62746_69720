#MESSAGES_REP_SERVER_MAINCLASS=replicated messages REST server class
#MESSAGES_REP_PORT=replicated messages REST server port
#MESSAGES_REP_EXTRA_ARGS_FIRST=extra arguments for the first replicated messages REST server (optional)
#MESSAGES_REP_EXTRA_ARGS_OTHER=extra arguments for the other replicated messages REST servers (optional)

#keystores for the users server (e.g. users.ourorg0,users.jks,users0pwd)
USERS_KEYSTORES=users.ourorg0,users_ourorg0.jks,users.ourorg0.pwd users.ourorg1,users_ourorg1.jks,users.ourorg1.pwd users.ourorg2,users_ourorg2.jks,users.ourorg2.pwd
#keystores for the messages servers - 1 per server in two replicated domains and one non-replicated domain (e.g. messages0.ourorg0,messages0-0.jks,messages0-0pwd messages1.ourorg0,messages1-0.jks,messages1-0pwd messages2.ourorg0,messages2-0.jks,messages2-0pwd messages0.ourorg1,messages0-1.jks,messages0-1pwd messages1.ourorg1,messages1-1.jks,messages1-1pwd  messages2.ourorg1,messages2-1.jks,messages2-1pwd messages0.ourorg2,messages0-2.jks,messages0-2pwd)
SERVERS_KEYSTORES=messages0.ourorg0,messages0_ourorg0.jks,messages0.ourorg0.pwd messages1.ourorg0,messages1_ourorg0.jks,messages1.ourorg0.pwd messages2.ourorg0,messages2_ourorg0.jks,messages2.ourorg0.pwd messages0.ourorg1,messages0_ourorg1.jks,messages0.ourorg1.pwd messages1.ourorg1,messages1_ourorg1.jks,messages1.ourorg1.pwd messages2.ourorg1,messages2_ourorg1.jks,messages2.ourorg1.pwd messages.ourorg2,messages_ourorg2.jks,messages.ourorg2.pwd
CLIENT_TRUSTSTORE=client_truststore.ks
CLIENT_TRUSTSTORE_PWD=changeit
